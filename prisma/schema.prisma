generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RestaurantRecordStatus {
  ACTIVE
  CLOSED
  SUPERSEDED
}

enum RestaurantAliasStatus {
  ACTIVE
  RETIRED
  SUSPECT
}

model RestaurantRecord {
  id                        String                   @id @default(cuid())
  restaurantKey             String                   @unique @db.VarChar(32)
  status                    RestaurantRecordStatus   @default(ACTIVE)
  canonicalName             String
  normalizedCanonicalName   String?
  canonicalAddress          String?
  normalizedCanonicalAddress String?
  lat                       Float?
  lng                       Float?
  phone                     String?
  normalizedPhone           String?
  websiteUrl                String?
  normalizedWebsiteHost     String?
  lastObservedSource        String?
  /// Latest validated provider snapshot; parsed through app-side runtime guards before use.
  lastSnapshotJson          Json?
  /// Latest validated photo proxy payload; parsed through app-side runtime guards before use.
  lastPhotoPayloadJson      Json?
  firstSeenAt               DateTime
  lastSeenAt                DateTime
  closedAt                  DateTime?
  supersededById            String?
  supersededBy              RestaurantRecord?        @relation("RestaurantSupersession", fields: [supersededById], references: [id])
  replacements              RestaurantRecord[]       @relation("RestaurantSupersession")
  aliases                   RestaurantAlias[]
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([normalizedCanonicalName])
  @@index([normalizedCanonicalAddress])
  @@index([normalizedPhone])
  @@index([normalizedWebsiteHost])
  @@index([lat, lng])
  @@index([supersededById])
  @@map("restaurants")
}

model RestaurantAlias {
  id           String                @id @default(cuid())
  restaurantId String
  restaurant   RestaurantRecord      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  provider     String
  providerId   String
  status       RestaurantAliasStatus @default(ACTIVE)
  /// Match confidence in the inclusive range [0, 1].
  confidence   Float                 @default(1)
  firstSeenAt  DateTime
  lastSeenAt   DateTime
  rawName      String?
  rawAddress   String?
  rawPhone     String?
  rawWebsiteUrl String?
  rawLat       Float?
  rawLng       Float?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([provider, providerId])
  @@index([restaurantId])
  @@map("restaurant_aliases")
}
