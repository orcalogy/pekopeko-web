{
  "name": "pekopeko",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome check --write ./src",
    "format": "biome format --write ./src",
    "check": "biome check ./src",
    "typecheck": "tsc --noEmit",
    "openapi:validate": "openapi-generator validate -i openapi/pekopeko-api.yaml",
    "openapi:generate:ts": "openapi-generator generate -i openapi/pekopeko-api.yaml -g typescript-fetch -c openapi/openapi-generator.typescript-fetch.yaml -o src/generated/api",
    "openapi:generate": "pnpm openapi:validate && pnpm openapi:generate:ts",
    "test:db:registry": "node --import ./scripts/register-ts-path-alias-loader.mjs --test src/lib/api/restaurant-registry.db.test.mts",
    "test:db:search-session": "node --import ./scripts/register-ts-path-alias-loader.mjs --test src/lib/api/search-session.db.test.mts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@mantine/carousel": "^9.0.1",
    "@mantine/core": "^9.0.1",
    "@mantine/form": "^9.0.1",
    "@mantine/hooks": "^9.0.1",
    "@mantine/notifications": "^9.0.1",
    "@mlc-ai/web-llm": "^0.2.82",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "leaflet": "^1.9.4",
    "next": "16.2.3",
    "next-intl": "^4.9.1",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@serwist/next": "^9.5.7",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.9",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "serwist": "^9.5.7",
    "typescript": "^5"
  }
}
